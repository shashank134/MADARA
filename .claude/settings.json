{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read", "Grep", "Glob", "WebFetch", "WebSearch",
      "Bash(subfinder:*)", "Bash(amass:*)", "Bash(dnsx:*)", "Bash(httpx:*)",
      "Bash(naabu:*)", "Bash(katana:*)", "Bash(gau:*)", "Bash(waybackurls:*)",
      "Bash(nuclei:*)", "Bash(ffuf:*)", "Bash(feroxbuster:*)", "Bash(whatweb:*)",
      "Bash(semgrep:*)", "Bash(jq:*)", "Bash(nmap:*)", "Bash(curl:*)",
      "mcp__playwright__browser_navigate", "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_click", "mcp__playwright__browser_type",
      "mcp__playwright__browser_take_screenshot"
    ],
    "deny": [
      "Bash(rm:*)", "Bash(sudo:*)", "Bash(dd:*)", "Bash(mkfs:*)",
      "Bash(:(){:|:&};:)", "Bash(shutdown:*)", "Bash(reboot:*)",
      "Read(./scope/**)", "Read(./.env)", "Read(./**/*.key)"
    ],
    "ask": [
      "Bash(git push:*)", "Write", "Edit"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch|Bash|mcp__playwright__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/scope-gate.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
